---
// Unica 404 per tutto il sito (GitHub Pages la serve per ogni indirizzo mancante): testo in entrambe le lingue.
import Base from '../layouts/Base.astro';
import { url } from '../utils';
---

<Base lang="it" title="404 — Pagina non trovata · Page not found">
  <section class="relative grid min-h-[80dvh] place-items-center px-4 pt-24 text-center">
    <div class="bg-grid pointer-events-none absolute inset-0" aria-hidden="true"></div>
    <div class="relative">
      <p class="eyebrow mb-6">java.lang.NullPointerException</p>
      <h1 class="display text-[clamp(6rem,22vw,14rem)] font-bold text-gradient">404</h1>
      <p class="mt-4 font-mono text-[var(--color-muted)] caret">Questa schermata non è nel back stack</p>
      <p class="mt-2 font-mono text-sm text-[var(--color-dim)]" lang="en">This screen isn't in the back stack</p>
      <div class="mt-10 flex flex-wrap justify-center gap-3">
        <a href={url('/')} class="btn btn-primary" data-magnetic>← Torna alla home</a>
        <a href={url('/en/')} class="btn btn-ghost" lang="en" data-magnetic>← Back to home</a>
      </div>
    </div>
  </section>
</Base>
