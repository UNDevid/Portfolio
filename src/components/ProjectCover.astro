---
// Copertina: usa l'immagine se presente, altrimenti genera una cover astratta dal colore accento.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { Platform } from '../config';
import BeatRunnerNeon from './effects/BeatRunnerNeon.astro';
import HailFall from './effects/HailFall.astro';
import AthanorBreath from './effects/AthanorBreath.astro';
import KenBurns from './effects/KenBurns.astro';
import SoundboardConcert from './effects/SoundboardConcert.astro';

export type CoverEffect = 'beatrunner-neon' | 'hail' | 'athanor-breath' | 'ken-burns' | 'soundboard-concert';

interface Props {
  title: string;
  accent: string;
  platform: Platform;
  cover?: ImageMetadata;
  monogram?: string;
  position?: 'left' | 'center' | 'right';
  effect?: CoverEffect;
  /** Larghezza mostrata, per scegliere la risoluzione giusta dal srcset. */
  sizes?: string;
  name?: string;
  class?: string;
  eager?: boolean;
}
const {
  title,
  accent,
  platform,
  cover,
  monogram,
  position = 'center',
  effect,
  sizes = '(min-width: 1152px) 540px, (min-width: 768px) 50vw, 100vw',
  name,
  class: cls = '',
  eager = false,
} = Astro.props;
// Solo le larghezze che la sorgente può davvero fornire.
const widths = cover ? [480, 720, 960, 1280, 1600, 1920, 2560].filter((w) => w <= cover.width) : [];
const glyph = { android: '</>', flutter: '◆', web: '{ }' }[platform];
const initials =
  monogram ??
  title
    .split(/[\s']+/)
    .filter((w) => w.length > 2)
    .slice(0, 2)
    .map((w) => w[0])
    .join('')
    .toUpperCase();
---

<div class:list={['cover relative overflow-hidden', cls]} style={`--c:${accent}`} transition:name={name} data-inspect="ProjectCover">
  {
    cover ? (
      <Image
        src={cover}
        alt={`Anteprima di ${title}`}
        class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-[1.04]"
        style={`object-position: ${position} center`}
        loading={eager ? 'eager' : 'lazy'}
        fetchpriority={eager ? 'high' : 'auto'}
        widths={widths}
        sizes={sizes}
        quality={85}
      />
    ) : (
      <div class="gen absolute inset-0" aria-hidden="true">
        <div class="orb orb-1" />
        <div class="orb orb-2" />
        <div class="grid-lines absolute inset-0" />
        <span class="glyph absolute right-5 bottom-3 font-mono text-[clamp(3rem,10vw,6rem)] font-bold">{glyph}</span>
        <span class="display absolute left-6 top-5 text-[clamp(2.5rem,7vw,4.5rem)] font-bold text-white/90">{initials}</span>
      </div>
    )
  }
  {effect === 'beatrunner-neon' && <BeatRunnerNeon />}
  {effect === 'hail' && <HailFall />}
  {effect === 'athanor-breath' && <AthanorBreath />}
  {effect === 'ken-burns' && <KenBurns />}
  {effect === 'soundboard-concert' && <SoundboardConcert />}
</div>

<style>
  .gen {
    background:
      radial-gradient(120% 80% at 0% 0%, color-mix(in oklab, var(--c) 30%, #0b0f14), transparent 60%),
      linear-gradient(160deg, #0d1218, #080a0e);
  }
  .orb {
    position: absolute;
    border-radius: 999px;
    filter: blur(40px);
    transition: transform 1.2s var(--ease-out);
  }
  .orb-1 {
    width: 55%;
    aspect-ratio: 1;
    right: -10%;
    top: -20%;
    background: color-mix(in oklab, var(--c) 55%, transparent);
  }
  .orb-2 {
    width: 35%;
    aspect-ratio: 1;
    left: 20%;
    bottom: -25%;
    background: color-mix(in oklab, var(--c) 30%, #4fc3f7 10%);
    opacity: 0.6;
  }
  :global(.group:hover) .orb-1 { transform: translate(-12%, 12%) scale(1.1); }
  :global(.group:hover) .orb-2 { transform: translate(15%, -10%); }
  .grid-lines {
    background-image:
      linear-gradient(to right, #ffffff0d 1px, transparent 1px),
      linear-gradient(to bottom, #ffffff0d 1px, transparent 1px);
    background-size: 28px 28px;
    mask-image: linear-gradient(to bottom, #000, transparent);
    -webkit-mask-image: linear-gradient(to bottom, #000, transparent);
  }
  .glyph {
    color: transparent;
    -webkit-text-stroke: 1.5px color-mix(in oklab, var(--c) 80%, white);
    opacity: 0.7;
  }
</style>
