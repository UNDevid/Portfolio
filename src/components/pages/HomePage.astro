---
// Home, uguale in italiano e in inglese: cambiano solo i testi.
import Base from '../../layouts/Base.astro';
import Hero from '../Hero.astro';
import StackMarquee from '../StackMarquee.astro';
import Projects from '../Projects.astro';
import Approach from '../Approach.astro';
import Contact from '../Contact.astro';
import About from '../About.astro';
import { lpath, type Lang } from '../../i18n';
import { getProjects } from '../../projects';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const projects = await getProjects(lang);
---

<Base lang={lang} alternate={lpath('/', lang === 'it' ? 'en' : 'it')}>
  <Hero projectCount={projects.length} lang={lang} />
  <StackMarquee lang={lang} />
  <Projects projects={projects} lang={lang} />
  <Approach lang={lang} />
  <About lang={lang} />
  <Contact lang={lang} />
</Base>
