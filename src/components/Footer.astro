---
import { site } from '../config';
const year = new Date().getFullYear();
---

<footer class="relative z-10 border-t border-[var(--color-line)]">
  <div
    class="mx-auto flex max-w-6xl flex-col gap-4 px-4 py-10 font-mono text-xs text-[var(--color-dim)] sm:flex-row sm:items-center sm:justify-between sm:px-8"
  >
    <p>© {year} {site.name} · Progettato e sviluppato a mano con Astro</p>
    <ul class="flex gap-5">
      {
        site.socials.map((s) => (
          <li>
            <a href={s.href} target="_blank" rel="noopener" class="link-underline hover:text-white">
              {s.label} ↗
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</footer>
