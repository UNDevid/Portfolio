---
// Chicchi di grandine che cadono, come nella top bar di HailGuard (HailAnimation.kt):
// caduta con accelerazione quadratica, leggera deriva laterale, dissolvenza in ingresso e in uscita.
interface Props {
  density?: number; // chicchi ogni 100px di larghezza
}
const { density = 2.6 } = Astro.props;
---

<canvas class="pointer-events-none absolute inset-0 h-full w-full" data-hail={density} aria-hidden="true"></canvas>

<script>
  type Stone = { x: number; speed: number; size: number; delay: number; wobble: number; cycle: number };

  const reduced = () => matchMedia('(prefers-reduced-motion: reduce)').matches;
  let stops: Array<() => void> = [];

  function start(canvas: HTMLCanvasElement) {
    const ctx = canvas.getContext('2d');
    if (!ctx) return () => {};
    const density = Number(canvas.dataset.hail || 2.6);
    let stones: Stone[] = [];
    let w = 0, h = 0, dpr = 1, raf = 0, visible = false;

    const resize = () => {
      dpr = Math.min(devicePixelRatio || 1, 2);
      w = canvas.clientWidth;
      h = canvas.clientHeight;
      canvas.width = Math.round(w * dpr);
      canvas.height = Math.round(h * dpr);
      const count = Math.max(8, Math.round((w / 100) * density));
      const unit = Math.max(1, w / 520); // chicchi più grandi sulle copertine grandi
      stones = Array.from({ length: count }, () => ({
        x: Math.random(),
        speed: Math.random() * 0.4 + 0.9,
        size: (Math.random() * 1.6 + 1.2) * unit,
        delay: Math.random(),
        wobble: Math.random() * 1.2,
        cycle: 1500 + Math.random() * 900,
      }));
    };

    const frame = (t: number) => {
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      ctx.clearRect(0, 0, w, h);
      for (const s of stones) {
        const p = (t / s.cycle + s.delay) % 1;
        const y = h * p * p * s.speed * 1.1 - s.size * 2;
        const x = w * s.x + w * 0.04 * p + Math.sin(p * 20) * s.wobble;
        const a = p < 0.03 ? p / 0.03 : p > 0.85 ? (1 - p) / 0.15 : 1;
        ctx.globalAlpha = 0.38 * a;
        ctx.fillStyle = '#e6f3ff';
        ctx.shadowColor = '#7cc8ff';
        ctx.shadowBlur = s.size * 1.2;
        ctx.beginPath();
        ctx.ellipse(x, y, s.size * 0.9, s.size, 0, 0, Math.PI * 2);
        ctx.fill();
      }
      raf = requestAnimationFrame(frame);
    };

    const ro = new ResizeObserver(resize);
    ro.observe(canvas);
    resize();
    // Gira solo mentre la copertina è sullo schermo.
    const io = new IntersectionObserver(([e]) => {
      visible = e.isIntersecting;
      cancelAnimationFrame(raf);
      if (visible) raf = requestAnimationFrame(frame);
    });
    io.observe(canvas);

    return () => {
      cancelAnimationFrame(raf);
      ro.disconnect();
      io.disconnect();
    };
  }

  document.addEventListener('astro:page-load', () => {
    stops.forEach((s) => s());
    stops = [];
    if (reduced()) return;
    document.querySelectorAll<HTMLCanvasElement>('canvas[data-hail]').forEach((c) => stops.push(start(c)));
  });
</script>
