---
// Le recensioni degli utenti in una colonna che scorre da sola, lentamente e all'infinito.
// Si ferma quando ci passi sopra, la tocchi, la scorri o ci arrivi con la tastiera; poi riparte.
// Con "riduci movimento" resta ferma e si scorre a mano.
import { t, type Lang } from '../i18n';

interface Props {
  lang: Lang;
  reviews: { author: string; date: string; stars: number; text: string }[];
  summary?: string;
  note?: string;
}
const { lang, reviews, summary, note } = Astro.props;
const tr = t(lang).project.reviews;
const fmt = new Intl.DateTimeFormat(tr.locale, { month: 'long', year: 'numeric' });
const when = (d: string) => fmt.format(new Date(`${d}T12:00:00`));
---

<section class="relative border-t border-[var(--color-line)] py-16" aria-labelledby="reviews-title">
  <div class="mx-auto grid max-w-6xl gap-10 px-4 sm:px-8 lg:grid-cols-[1fr_1.3fr] lg:items-center">
    <div>
      <p class="eyebrow mb-4" data-reveal><span class="text-[var(--accent)]">★</span> Google Play</p>
      <h2 id="reviews-title" class="display text-[clamp(2rem,4.5vw,3.2rem)] font-semibold" data-reveal style="--d:80ms">
        {tr.title}
      </h2>
      {summary && <p class="mt-4 font-mono text-sm text-[var(--accent)]" data-reveal style="--d:140ms">{summary}</p>}
      {note && <p class="mt-3 max-w-sm text-sm text-[var(--color-muted)]" data-reveal style="--d:180ms">{note}</p>}
    </div>

    <div class="reviews relative" data-reveal style="--d:120ms">
      <div class="reviews-scroll h-[440px] overflow-y-auto pr-2" data-reviews tabindex="0" role="region" aria-label={tr.aria}>
        {
          [0, 1].map((copy) => (
            <ul class="space-y-3 pb-3" aria-hidden={copy === 1 ? 'true' : undefined} data-copy={copy}>
              {reviews.map((r) => (
                <li class="review rounded-2xl border border-[var(--color-line)] bg-[var(--color-surface)] p-5">
                  <p class="font-mono text-sm tracking-wider text-[var(--accent)]" aria-label={tr.stars(r.stars)}>
                    {'★'.repeat(r.stars)}
                    <span class="text-[var(--color-line-strong)]">{'★'.repeat(5 - r.stars)}</span>
                  </p>
                  <p class="mt-2 leading-relaxed text-[#d6dde6]">“{r.text}”</p>
                  <p class="mt-3 font-mono text-[11px] text-[var(--color-dim)]">
                    {r.author} · {when(r.date)}
                  </p>
                </li>
              ))}
            </ul>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .reviews::before,
  .reviews::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0.5rem;
    height: 56px;
    z-index: 1;
    pointer-events: none;
  }
  .reviews::before {
    top: 0;
    background: linear-gradient(var(--color-bg), transparent);
  }
  .reviews::after {
    bottom: 0;
    background: linear-gradient(transparent, var(--color-bg));
  }
  .reviews-scroll {
    scrollbar-width: thin;
    scrollbar-color: var(--sb-thumb) transparent;
    overscroll-behavior: contain;
  }
  .reviews-scroll:focus-visible {
    outline-offset: 6px;
  }
  .review {
    transition: border-color 0.4s var(--ease-out);
  }
  .review:hover {
    border-color: color-mix(in oklab, var(--accent) 45%, transparent);
  }
</style>

<script>
  const SPEED = 22; // pixel al secondo
  const RESUME = 2500; // ms dopo l'ultima interazione
  let stops: Array<() => void> = [];

  function run(box: HTMLElement) {
    const first = box.querySelector<HTMLElement>('[data-copy="0"]')!;
    let paused = false;
    let resumeAt = 0;
    let last = 0;
    let pos = box.scrollTop;
    let raf = 0;

    const hold = (ms = RESUME) => {
      resumeAt = performance.now() + ms;
    };
    const tick = (now: number) => {
      const dt = last ? Math.min(now - last, 64) : 0;
      last = now;
      if (!paused && now >= resumeAt) {
        pos += (SPEED * dt) / 1000;
        const loop = first.offsetHeight; // alla fine della prima copia si riparte, senza stacchi
        if (pos >= loop) pos -= loop;
        box.scrollTop = pos;
      } else {
        pos = box.scrollTop;
        if (pos >= first.offsetHeight) {
          pos -= first.offsetHeight;
          box.scrollTop = pos;
        }
      }
      raf = requestAnimationFrame(tick);
    };

    const on = (type: string, fn: EventListener, opts?: AddEventListenerOptions) => {
      box.addEventListener(type, fn, opts);
      stops.push(() => box.removeEventListener(type, fn));
    };
    on('pointerenter', () => (paused = true));
    on('pointerleave', () => {
      paused = false;
      hold(800);
    });
    on('focusin', () => (paused = true));
    on('focusout', () => (paused = false));
    on('wheel', () => hold(), { passive: true });
    on('touchstart', () => hold(4000), { passive: true });
    on('keydown', () => hold());

    // Scorre solo quando è sullo schermo.
    const io = new IntersectionObserver(([e]) => {
      cancelAnimationFrame(raf);
      last = 0;
      if (e.isIntersecting) raf = requestAnimationFrame(tick);
    });
    io.observe(box);
    stops.push(() => {
      cancelAnimationFrame(raf);
      io.disconnect();
    });
  }

  document.addEventListener('astro:page-load', () => {
    stops.forEach((s) => s());
    stops = [];
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    document.querySelectorAll<HTMLElement>('[data-reviews]').forEach(run);
  });
</script>
