---
import { stack, skills } from '../config';

const tracks = [
  { cls: 'only-plain', label: 'Competenze', items: skills },
  { cls: 'only-tech', label: 'Tecnologie', items: stack },
];
---

{
  tracks.map((t) => (
    <section
      class:list={[t.cls, 'relative border-y border-[var(--color-line)] bg-[var(--color-bg-2)]/60 py-6']}
      aria-label={t.label}
    >
      <div class="marquee overflow-hidden">
        <ul class="marquee-track">
          {[...t.items, ...t.items].map((item, i) => (
            <li
              class="flex items-center gap-10 pr-10 font-mono text-sm text-[var(--color-muted)]"
              aria-hidden={i >= t.items.length ? 'true' : undefined}
            >
              <span class="whitespace-nowrap transition-colors hover:text-white">{item}</span>
              <span class="text-[var(--accent)] opacity-60">✦</span>
            </li>
          ))}
        </ul>
      </div>
    </section>
  ))
}
