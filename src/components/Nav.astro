---
import { site } from '../config';
import { url } from '../utils';

const links = [
  { href: url('/#progetti'), label: 'Progetti' },
  { href: url('/#approccio'), label: 'Approccio' },
  { href: url('/#contatti'), label: 'Contatti' },
];
---

<header
  data-nav
  class="group fixed inset-x-0 top-0 z-50 flex justify-center px-4 pt-4"
  transition:persist
>
  <nav
    class="glass flex w-full max-w-5xl items-center justify-between gap-4 rounded-full px-3 py-2 pl-5 transition-all duration-500 group-data-[scrolled]:max-w-3xl group-data-[scrolled]:shadow-[0_20px_60px_-20px_#000]"
    aria-label="Principale"
  >
    <a href={url('/')} class="flex items-center gap-2 font-mono text-sm font-medium">
      <span class="relative flex h-2.5 w-2.5">
        <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-[var(--accent)] opacity-60"></span>
        <span class="relative inline-flex h-2.5 w-2.5 rounded-full bg-[var(--accent)]"></span>
      </span>
      <span>{site.handle}<span class="text-[var(--color-dim)]">.dev</span></span>
    </a>
    <ul class="hidden items-center gap-1 sm:flex">
      {
        links.map((l) => (
          <li>
            <a
              href={l.href}
              class="rounded-full px-4 py-2 text-sm text-[var(--color-muted)] transition-colors hover:bg-white/5 hover:text-white"
            >
              {l.label}
            </a>
          </li>
        ))
      }
    </ul>
    <a href={url('/#contatti')} class="btn btn-primary !px-4 !py-2 text-sm" data-magnetic>
      Parliamone
    </a>
  </nav>
</header>
