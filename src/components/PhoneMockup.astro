---
// Il telefono della hero: una home Android con le mie app, a colori dinamici (Material You).
// In alto i widget veri di HailGuard e Beat Runner (ricostruiti dal codice Glance), in basso le icone
// dei cinque progetti. A turno un "tocco" su un'icona fa partire un'onda di colore e tutta la home
// prende la palette di quell'app, come il colore dinamico di Android 12+. In modalità tecnica la
// finestra accanto mostra il codice di quell'app. Le icone portano alla pagina del progetto.
import { getImage } from 'astro:assets';
import '@fontsource/anton/latin-400.css';
import { t, lpath, type Lang } from '../i18n';
import { snippets, highlight } from '../mockup-snippets';

import iconBeatRunner from '../assets/mockup/icon-beatrunner.png';
import iconHailGuard from '../assets/mockup/icon-hailguard.png';
import iconSoundboard from '../assets/mockup/icon-soundboard.png';
import iconCavagliato from '../assets/mockup/icon-cavagliato.png';
import iconAthanor from '../assets/mockup/icon-athanor.png';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const d = t(lang);
const m = d.mockup;

const icon = async (src: ImageMetadata) => (await getImage({ src, width: 96, format: 'webp' })).src;

// you: il colore sorgente dell'app · on: il testo sopra quel colore
const apps = [
  { id: 'beatrunner', name: 'Beat Runner', icon: await icon(iconBeatRunner), you: '#C1EF00', on: '#0B0D05' },
  { id: 'hailguard', name: 'HailGuard', icon: await icon(iconHailGuard), you: '#7CC8FF', on: '#04223A' },
  { id: 'soundboard', name: 'Soundboard', icon: await icon(iconSoundboard), you: '#FF6A2A', on: '#2A0D00' },
  { id: 'athanor', name: 'Athanor', icon: await icon(iconAthanor), you: '#E8A33D', on: '#2A1A06' },
  { id: 'carmagnola', name: 'Cavagliato', icon: await icon(iconCavagliato), you: '#F0483E', on: '#2B0503', snippet: 'cavagliato' },
].map((a) => ({ ...a, href: lpath(`/projects/${a.id}/`, lang), snippet: a.snippet ?? a.id }));
const start = apps[0];

const panes = ['home', ...apps.map((a) => a.snippet)].map((id) => ({
  id,
  file: snippets[id].file,
  html: highlight(snippets[id], lang),
}));
const riskColors = ['#E57373', '#FFB74D', '#8a8f98'];
---

<div
  class="phone-scene relative mx-auto w-full max-w-[420px]"
  data-phone
  data-inspect="PhoneMockup"
  role="group"
  aria-label={m.phoneAria}
  style={`--you:${start.you};--you-on:${start.on}`}
>
  <!-- codice dell'app che dà i colori, solo in modalità tecnica -->
  <div class="only-tech code-window glass absolute -left-4 top-6 hidden w-[350px] rounded-2xl p-4 font-mono text-[10.5px] leading-relaxed md:block lg:-left-6 xl:-left-24" aria-hidden="true">
    <div class="mb-3 flex items-center gap-1.5">
      <span class="h-2.5 w-2.5 rounded-full bg-[#ff5f57]"></span>
      <span class="h-2.5 w-2.5 rounded-full bg-[#febc2e]"></span>
      <span class="h-2.5 w-2.5 rounded-full bg-[#28c840]"></span>
      <span class="ml-2 text-[var(--color-dim)]" data-code-file>{panes[0].file}</span>
    </div>
    <div class="code-panes relative">
      {panes.map((p, i) => <pre class:list={['code-pane whitespace-pre text-[#b7c0cc]', i === 0 && 'is-on']} data-snippet={p.id} data-file={p.file} set:html={p.html} />)}
    </div>
  </div>

  <!-- telefono -->
  <div class="phone relative z-10 ml-auto aspect-[9/19] w-[260px] rounded-[44px] p-[10px] sm:w-[280px]" data-tilt="8">
    <div class="screen relative h-full w-full overflow-hidden rounded-[36px]" data-screen>
      <div class="wallpaper absolute inset-0" aria-hidden="true"></div>
      <span class="wave pointer-events-none absolute z-[5] rounded-full" data-wave aria-hidden="true"></span>
      <div class="pointer-events-none absolute inset-0 z-30" style="background: radial-gradient(400px circle at var(--gx,30%) var(--gy,0%), #ffffff12, transparent 45%)" aria-hidden="true"></div>

      <!-- barra di stato -->
      <div class="relative z-10 flex items-center justify-between px-6 pt-3 font-mono text-[10px] text-white/75" aria-hidden="true">
        <span class="w-16">9:41</span>
        <span class="h-3.5 w-3.5 rounded-full bg-black ring-1 ring-white/10"></span>
        <!-- icone di sistema in stile Android: Wi-Fi, rete mobile, batteria -->
        <span class="flex w-16 items-center justify-end gap-1 text-white/85">
          <svg class="h-[11px] w-[11px]" viewBox="0 0 24 24" fill="currentColor"><path d="M12 21 0 7.6A17.6 17.6 0 0 1 12 3a17.6 17.6 0 0 1 12 4.6z" /></svg>
          <svg class="h-[11px] w-[11px]" viewBox="0 0 24 24" fill="currentColor"><path d="M2 22h20V2z" /></svg>
          <span class="relative ml-0.5 flex h-[9px] w-[17px] items-center rounded-[2.5px] border border-current p-[1px]">
            <span class="h-full w-[78%] rounded-[1px] bg-current"></span>
            <span class="absolute -right-[3px] top-1/2 h-[4px] w-[1.5px] -translate-y-1/2 rounded-r-sm bg-current"></span>
          </span>
        </span>
      </div>

      <div class="relative z-10 flex h-[calc(100%-26px)] flex-col px-3 pt-4 pb-3">
        <!-- "In breve" di Android: ora, data di oggi e da quale app arrivano i colori -->
        <div class="glance mb-3 px-2" aria-hidden="true">
          <p class="glance-time font-display text-[22px] leading-none font-medium">9:41</p>
          <p class="mt-1.5 text-[10px] text-white/70 first-letter:uppercase" data-glance-date data-locale={lang === 'en' ? 'en-GB' : 'it-IT'}>
            {new Intl.DateTimeFormat(lang === 'en' ? 'en-GB' : 'it-IT', { weekday: 'long', day: 'numeric', month: 'long' }).format(new Date())}
          </p>
          <p class="you-chip mt-2 inline-flex items-center gap-1.5 rounded-full py-0.5 pr-2 pl-1 text-[8.5px]">
            <span class="flex">
              <span class="swatch swatch-1"></span><span class="swatch swatch-2"></span><span class="swatch swatch-3"></span>
            </span>
            <span>{m.themed} <b data-you-name>{start.name}</b></span>
          </p>
        </div>

        <!-- widget HailGuard -->
        <div class="hg-widget rounded-[18px] p-2.5" aria-hidden="true">
          <div class="flex items-center gap-1.5 px-1">
            <svg class="h-4 w-4 text-white" viewBox="0 0 24 24" fill="currentColor"><path d="M7 15a5 5 0 1 1 1.2-9.86A6 6 0 0 1 19.5 8 4 4 0 0 1 18 15.7V15z" opacity=".95"/><circle cx="8" cy="19" r="1.2"/><circle cx="12" cy="21" r="1.2"/><circle cx="16" cy="19" r="1.2"/></svg>
            <span class="hg-title flex-1">HAILGUARD</span>
            <svg class="h-3.5 w-3.5 text-white/90" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="M20 12a8 8 0 1 1-2.3-5.6"/><path d="M20 4v5h-5"/></svg>
          </div>
          <ul class="mt-2 space-y-1.5">
            {
              m.hail.rows.map((row, i) => (
                <li class="hg-row flex items-center justify-between rounded-[10px] px-2.5 py-1.5">
                  <span class="text-[10px] text-[#e8f4fd]">{row}</span>
                  <span class:list={['flex items-center gap-1 text-[10px] font-medium', i === 0 && 'hg-alert']} style={`color:${riskColors[i]}`}>
                    {i === 0 && <span class="h-1.5 w-1.5 rounded-full" style={`background:${riskColors[0]}`} />}
                    {m.hail.risks[i]}
                  </span>
                </li>
              ))
            }
          </ul>
        </div>

        <!-- widget Beat Runner: come nell'app, l'accento segue i colori del sistema -->
        <div class="br-widget mt-2.5 rounded-[18px] p-3" aria-hidden="true">
          <div class="flex items-center">
            <div class="flex-1">
              <p class="text-[9px] text-[#9AA1A9]">{m.week.title}</p>
              <p class="text-[19px] font-bold leading-tight text-[#F2F4F5]">{m.week.km}</p>
              <p class="text-[9px] text-[#9AA1A9]">{m.week.runs}</p>
            </div>
            <span class="br-play grid h-9 w-9 place-items-center rounded-full">
              <svg class="ml-0.5 h-4 w-4" viewBox="0 0 24 24"><path d="M8 5v14l11-7z" /></svg>
            </span>
          </div>
          <div class="mt-2 flex justify-between px-0.5">
            {
              m.week.days.map((day, i) => (
                <span class="flex flex-col items-center gap-1">
                  <span class:list={['br-dot h-1.5 w-1.5 rounded-full', [0, 2, 4].includes(i) && 'is-active']} style={`--i:${i}`} />
                  <span class:list={['text-[8px]', [0, 2, 4].includes(i) ? 'text-[#F2F4F5]' : 'text-[#9AA1A9]']}>{day}</span>
                </span>
              ))
            }
          </div>
          <div class="mt-2 flex items-center gap-1.5">
            <svg class="br-note h-3 w-3" viewBox="0 0 24 24"><path d="M12 3v10.55A4 4 0 1 0 14 17V7h4V3z" /></svg>
            <span class="text-[9px] text-[#F2F4F5]">{m.week.playlist}</span>
          </div>
        </div>

        <!-- icone dei progetti -->
        <ul class="mt-auto grid grid-cols-5 gap-1 px-0.5 pb-2">
          {
            apps.map((a, i) => (
              <li>
                <a
                  href={a.href}
                  class:list={['app-icon flex flex-col items-center gap-1', i === 0 && 'is-you']}
                  data-app={a.id}
                  data-you={a.you}
                  data-on={a.on}
                  data-name={a.name}
                  data-snippet={a.snippet}
                  aria-label={m.open(a.name)}
                >
                  <img src={a.icon} alt="" width="40" height="40" class="icon h-10 w-10 rounded-[12px] object-cover" loading="lazy" decoding="async" />
                  <span class="w-full truncate text-center text-[8px] text-white/80">{a.name}</span>
                </a>
              </li>
            ))
          }
        </ul>
        <div class="nav-pill mx-auto h-1 w-20 rounded-full" aria-hidden="true"></div>
      </div>

      <span class="tap pointer-events-none absolute z-40 h-9 w-9 rounded-full" data-tap aria-hidden="true"></span>
    </div>
  </div>

  <div class="glow absolute -right-10 top-1/4 -z-0 h-72 w-72 rounded-full blur-3xl" aria-hidden="true"></div>
</div>

<style is:global>
  /* Registrata, così il colore dinamico sfuma da una palette all'altra anche dentro i gradienti */
  @property --you {
    syntax: '<color>';
    inherits: true;
    initial-value: #c1ef00;
  }
  @property --you-on {
    syntax: '<color>';
    inherits: true;
    initial-value: #0b0d05;
  }
</style>

<style>

  .phone-scene {
    transition:
      --you 1.1s cubic-bezier(0.2, 0.8, 0.2, 1),
      --you-on 1.1s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .phone {
    background: linear-gradient(145deg, #2a313c, #0d1117 40%, #1b2129);
    box-shadow:
      inset 0 0 0 1px #ffffff1f,
      0 50px 100px -30px #000,
      0 0 0 1px #000;
    transition: transform 0.6s var(--ease-out);
    transform-style: preserve-3d;
    animation: float 7s ease-in-out infinite;
  }

  /* Lo sfondo prende il colore dell'app, come il wallpaper con Material You */
  .wallpaper {
    background:
      radial-gradient(120% 60% at 85% 0%, color-mix(in oklab, var(--you) 30%, transparent), transparent 62%),
      radial-gradient(90% 55% at 0% 100%, color-mix(in oklab, var(--you) 16%, transparent), transparent 70%),
      linear-gradient(180deg, color-mix(in oklab, var(--you) 7%, #0c1016), #07090d);
  }
  .wave {
    width: 40px;
    height: 40px;
    opacity: 0;
    transform: translate(-50%, -50%) scale(0);
    background: radial-gradient(circle, var(--wave, #fff) 0%, color-mix(in oklab, var(--wave, #fff) 50%, transparent) 45%, transparent 70%);
  }

  .glance-time {
    color: color-mix(in oklab, var(--you) 55%, #ffffff);
  }
  .you-chip {
    background: color-mix(in oklab, var(--you) 16%, #ffffff0a);
    color: color-mix(in oklab, var(--you) 45%, #ffffff);
    box-shadow: inset 0 0 0 1px color-mix(in oklab, var(--you) 30%, transparent);
  }
  .you-chip b {
    font-weight: 600;
    color: #fff;
  }
  .swatch {
    width: 9px;
    height: 9px;
    border-radius: 999px;
    margin-left: -3px;
    box-shadow: 0 0 0 1.5px #0c1016;
  }
  .swatch:first-child { margin-left: 0; }
  .swatch-1 { background: var(--you); }
  .swatch-2 { background: color-mix(in oklab, var(--you) 55%, #1a1d21); }
  .swatch-3 { background: color-mix(in oklab, var(--you) 25%, #e8edf3); }

  .code-window {
    animation: float 9s ease-in-out -2s infinite;
    box-shadow: 0 30px 80px -30px #000;
  }
  .code-pane {
    position: absolute;
    inset: 0 auto auto 0;
    opacity: 0;
    transform: translateY(6px);
    transition: opacity 0.35s var(--ease-out), transform 0.35s var(--ease-out);
  }
  .code-pane.is-on {
    position: relative;
    opacity: 1;
    transform: none;
  }
  .code-pane :global(.k) { color: #c792ea; }
  .code-pane :global(.f) { color: #82aaff; }
  .code-pane :global(.t) { color: var(--color-volt); }
  .code-pane :global(.s) { color: #c3e88d; }
  .code-pane :global(.n) { color: #f78c6c; }
  .code-pane :global(.c) { color: #5b6573; font-style: italic; }

  /* Widget HailGuard: la sua base navy, con la tinta del colore dinamico */
  .hg-widget {
    background: linear-gradient(
      160deg,
      color-mix(in oklab, var(--you) 10%, #0d1b2a),
      color-mix(in oklab, var(--you) 18%, #1a2f4d)
    );
    box-shadow: inset 0 0 0 1px color-mix(in oklab, var(--you) 22%, #ffffff12);
  }
  .hg-title {
    font-family: 'Anton', sans-serif;
    font-style: italic;
    transform: skewX(-8deg);
    font-size: 14px;
    letter-spacing: 0.02em;
    color: #fff;
    line-height: 1;
  }
  .hg-row { background: color-mix(in oklab, var(--you) 10%, #22304d); }
  .hg-alert span { animation: pulse 1.6s ease-in-out infinite; }

  /* Widget Beat Runner: grafite, con l'accento che segue il sistema (come "accento dallo sfondo" nell'app) */
  .br-widget {
    background: color-mix(in oklab, var(--you) 7%, #1a1d21);
    box-shadow: inset 0 0 0 1px color-mix(in oklab, var(--you) 16%, #ffffff0f);
  }
  .br-play {
    background: var(--you);
    box-shadow: 0 0 18px -4px var(--you);
  }
  .br-play path { fill: var(--you-on); }
  .br-note path { fill: var(--you); }
  .br-dot { background: #2e3338; }
  .br-dot.is-active {
    background: var(--you);
    animation: dot-in 0.5s var(--ease-out) backwards;
    animation-delay: calc(var(--i) * 0.12s + 0.6s);
  }

  .app-icon .icon {
    box-shadow: 0 6px 14px -6px #000;
    outline: 2px solid transparent;
    outline-offset: 2px;
    transition:
      transform 0.4s var(--ease-out),
      outline-color 0.6s var(--ease-out);
  }
  .app-icon:hover .icon,
  .app-icon:focus-visible .icon { transform: scale(1.08); }
  .app-icon.is-you .icon {
    outline-color: var(--you);
    transform: scale(1.06);
  }
  .nav-pill { background: color-mix(in oklab, var(--you) 60%, #ffffff66); }

  .tap {
    background: #ffffff;
    opacity: 0;
    transform: translate(-50%, -50%) scale(0.5);
  }
  .glow {
    background: radial-gradient(circle, color-mix(in oklab, var(--you) 45%, transparent), transparent 70%);
    opacity: 0.5;
  }

  @keyframes float { 50% { translate: 0 -14px; } }
  @keyframes pulse { 50% { opacity: 0.35; } }
  @keyframes dot-in { from { transform: scale(0); } }

  @media (prefers-reduced-motion: reduce) {
    .phone, .code-window, .hg-alert span, .br-dot.is-active { animation: none; }
    .phone-scene { transition: none; }
  }
</style>

<script>
  // A turno, un tocco su un'icona: onda di colore dall'icona e la home prende la palette dell'app.
  const reduced = () => matchMedia('(prefers-reduced-motion: reduce)').matches;
  let stops: Array<() => void> = [];

  function run(phone: HTMLElement) {
    const screen = phone.querySelector<HTMLElement>('[data-screen]')!;
    const wave = phone.querySelector<HTMLElement>('[data-wave]')!;
    const tap = phone.querySelector<HTMLElement>('[data-tap]')!;
    const nameEl = phone.querySelector<HTMLElement>('[data-you-name]');
    const file = phone.querySelector<HTMLElement>('[data-code-file]');
    const panes = [...phone.querySelectorAll<HTMLElement>('pre[data-snippet]')];
    const apps = [...phone.querySelectorAll<HTMLAnchorElement>('[data-app]')];

    let alive = true;
    let visible = false;
    let wake: (() => void) | null = null;
    const sleep = (ms: number) =>
      new Promise<void>((resolve) => {
        const id = setTimeout(resolve, ms);
        stops.push(() => clearTimeout(id));
      });
    const ready = () => (visible && !document.hidden ? Promise.resolve() : new Promise<void>((r) => (wake = r)));
    const io = new IntersectionObserver(([e]) => {
      visible = e.isIntersecting;
      if (visible && wake) {
        wake();
        wake = null;
      }
    });
    io.observe(phone);
    const onVis = () => !document.hidden && wake && (wake(), (wake = null));
    document.addEventListener('visibilitychange', onVis);
    stops.push(() => {
      alive = false;
      io.disconnect();
      document.removeEventListener('visibilitychange', onVis);
    });

    const showCode = (id: string) => {
      panes.forEach((p) => p.classList.toggle('is-on', p.dataset.snippet === id));
      const on = panes.find((p) => p.dataset.snippet === id);
      if (file && on) file.textContent = on.dataset.file ?? '';
    };
    const center = (a: HTMLElement) => {
      const s = screen.getBoundingClientRect();
      const r = (a.querySelector('.icon') as HTMLElement).getBoundingClientRect();
      return { x: r.left + r.width / 2 - s.left, y: r.top + r.height / 2 - s.top, w: s.width, h: s.height };
    };

    (async () => {
      let i = 0;
      await sleep(3200);
      while (alive) {
        await ready();
        if (!alive) return;
        i = (i + 1) % apps.length;
        const app = apps[i];
        const c = center(app);

        // Il tocco sull'icona
        tap.style.left = `${c.x}px`;
        tap.style.top = `${c.y}px`;
        await tap.animate(
          [
            { opacity: 0, transform: 'translate(-50%,-50%) scale(.4)' },
            { opacity: 0.35, transform: 'translate(-50%,-50%) scale(1)' },
            { opacity: 0, transform: 'translate(-50%,-50%) scale(1.5)' },
          ],
          { duration: 420, easing: 'ease-out' },
        ).finished;

        // L'onda di colore parte dall'icona e attraversa lo schermo
        const reach = Math.hypot(Math.max(c.x, c.w - c.x), Math.max(c.y, c.h - c.y)) * 2;
        wave.style.left = `${c.x}px`;
        wave.style.top = `${c.y}px`;
        wave.style.setProperty('--wave', app.dataset.you!);
        wave.animate(
          [
            { opacity: 0.55, transform: 'translate(-50%,-50%) scale(0)' },
            { opacity: 0.35, transform: `translate(-50%,-50%) scale(${reach / 40 / 2})`, offset: 0.55 },
            { opacity: 0, transform: `translate(-50%,-50%) scale(${reach / 40})` },
          ],
          { duration: 1300, easing: 'cubic-bezier(.2,.8,.2,1)' },
        );

        // La nuova palette (le variabili registrate sfumano da sole)
        phone.style.setProperty('--you', app.dataset.you!);
        phone.style.setProperty('--you-on', app.dataset.on!);
        apps.forEach((a) => a.classList.toggle('is-you', a === app));
        if (nameEl) nameEl.textContent = app.dataset.name!;
        showCode(app.dataset.snippet!);

        await sleep(3800);
      }
    })();
  }

  document.addEventListener('astro:page-load', () => {
    stops.forEach((s) => s());
    stops = [];
    // La data di oggi nella lingua della pagina
    document.querySelectorAll<HTMLElement>('[data-glance-date]').forEach((el) => {
      el.textContent = new Intl.DateTimeFormat(el.dataset.locale, { weekday: 'long', day: 'numeric', month: 'long' }).format(new Date());
    });
    if (reduced()) return;
    document.querySelectorAll<HTMLElement>('[data-phone]').forEach(run);
  });
</script>
