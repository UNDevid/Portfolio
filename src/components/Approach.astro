---
// I testi (racconto per tutti e versione tecnica) sono nel dizionario: src/i18n.ts → approach.
import { t, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}
const d = t(Astro.props.lang);
const pillars = d.approach.pillars.map((p, i) => ({ ...p, n: String(i + 1).padStart(2, '0') }));
const steps = d.approach.steps;
---

<section id={d.anchors.approach} class="relative scroll-mt-24 border-t border-[var(--color-line)] bg-[var(--color-bg-2)]/50">
  <div class="mx-auto max-w-6xl px-4 py-24 sm:px-8 sm:py-32">
    <div class="grid gap-12 lg:grid-cols-[1fr_1.4fr]">
      <div class="lg:sticky lg:top-32 lg:self-start">
        <p class="eyebrow mb-4" data-reveal><span class="text-[var(--accent)]">02</span> / {d.approach.eyebrow}</p>
        <h2 class="display text-[clamp(2.2rem,5vw,3.6rem)] font-semibold" data-reveal style="--d:80ms">
          {d.approach.title1}<br />{d.approach.title2}
        </h2>
        <p class="mt-6 max-w-md leading-relaxed text-[var(--color-muted)]" data-reveal style="--d:160ms">
          {d.approach.text}
        </p>
        <ol class="mt-10 flex flex-wrap items-center gap-2 font-mono text-xs text-[var(--color-muted)]" data-reveal style="--d:240ms">
          {
            steps.map((s, i) => (
              <li class="flex items-center gap-2">
                <span class="chip !text-white">{s}</span>
                {i < steps.length - 1 && <span class="text-[var(--color-dim)]">→</span>}
              </li>
            ))
          }
        </ol>
      </div>

      <ul class="grid gap-4 sm:grid-cols-2">
        {
          pillars.map((p, i) => (
            <li
              data-inspect="Pillar"
              class="group relative overflow-hidden rounded-3xl border border-[var(--color-line)] bg-[var(--color-surface)] p-7 transition-colors duration-500 hover:border-[color-mix(in_oklab,var(--accent)_40%,transparent)]"
              data-reveal
              style={`--d:${i * 90}ms`}
            >
              <span class="font-mono text-xs text-[var(--accent)]">{p.n}</span>
              {(['plain', 'tech'] as const).map((v) => (
                <div class={`only-${v}`}>
                  <h3 class="display mt-10 text-2xl font-semibold">{p[v].title}</h3>
                  <p class="mt-3 text-[0.95rem] leading-relaxed text-[var(--color-muted)]">{p[v].text}</p>
                  <p class="mt-6 font-mono text-[11px] text-[var(--color-dim)]">{p[v].tag}</p>
                </div>
              ))}
              <span
                class="display pointer-events-none absolute -right-2 -top-6 text-[7rem] font-bold text-white/[0.03] transition-transform duration-700 group-hover:-translate-x-3"
                aria-hidden="true"
              >
                {p.n}
              </span>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
