---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { site } from '../config';
import { url } from '../utils';
import { t, type Lang } from '../i18n';

interface Props {
  lang: Lang;
  /** La stessa pagina nell'altra lingua (percorso con il base). Assente per la 404. */
  alternate?: string;
  title?: string;
  description?: string;
  accent?: string;
  /** Immagine di anteprima (public/og/...), percorso senza base. */
  ogImage?: string;
}

const { lang, alternate, accent } = Astro.props;
const ogImage = new URL(url(Astro.props.ogImage ?? `/og/${lang}/home.jpg`), Astro.site);
const d = t(lang);
const title = Astro.props.title ?? `${site.name} — ${site.role}`;
const description = Astro.props.description ?? d.hero.intro.plain;
const other: Lang = lang === 'it' ? 'en' : 'it';
const canonical = new URL(Astro.url.pathname, Astro.site);
const alternateUrl = alternate ? new URL(alternate, Astro.site) : undefined;
const itUrl = lang === 'it' || !alternateUrl ? canonical : alternateUrl;
---

<!doctype html>
<html lang={d.meta.htmlLang} data-alt={alternate} style={accent ? `--accent:${accent}` : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#07090d" />
    <link rel="canonical" href={canonical} />
    {
      alternateUrl && (
        <>
          <link rel="alternate" hreflang={lang} href={canonical} />
          <link rel="alternate" hreflang={other} href={alternateUrl} />
          <link rel="alternate" hreflang="x-default" href={itUrl} />
        </>
      )
    }
    <link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={d.meta.ogLocale} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta property="og:site_name" content={site.name} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    <script is:inline>
      (function () {
        var d = document.documentElement;
        d.classList.add('js');
        var q = new URLSearchParams(location.search);
        try {
          // Lingua: ?lang=it|en nel link, poi la scelta fatta con l'interruttore, poi la lingua del browser.
          // Solo al primo caricamento (non nei cambi di pagina interni); i motori di ricerca restano dove sono.
          if (window.__langChecked) throw 0;
          window.__langChecked = true;
          var lang = d.lang;
          var alt = d.getAttribute('data-alt');
          var pref = q.get('lang');
          if (pref === 'it' || pref === 'en') localStorage.setItem('portfolio-lang', pref);
          else pref = localStorage.getItem('portfolio-lang');
          if (!pref) {
            var list = navigator.languages || [navigator.language || ''];
            pref = list.some(function (l) { return /^it\b/i.test(l); }) ? 'it' : 'en';
          }
          var bot = /bot|crawl|spider|slurp|google|bing|duckduck|baidu|yandex/i.test(navigator.userAgent);
          if (pref !== lang && alt && !bot) {
            location.replace(alt + location.hash);
            return;
          }
        } catch (e) {}
        // Modalità di lettura: ?view=tech|plain nel link, altrimenti l'ultima scelta, altrimenti "plain".
        var v = null;
        try {
          var qv = q.get('view');
          if (qv === 'tech' || qv === 'plain') {
            v = qv;
            localStorage.setItem('portfolio-view', qv);
          } else {
            v = localStorage.getItem('portfolio-view');
          }
        } catch (e) {}
        d.dataset.view = v === 'tech' ? 'tech' : 'plain';
      })();
    </script>
    <ClientRouter />
    {
      site.goatcounter && import.meta.env.PROD && (
        <>
          <script is:inline async data-goatcounter={`https://${site.goatcounter}.goatcounter.com/count`}data-goatcounter-settings='{"no_onload": true}' src="https://gc.zgo.at/count.js" />
          <script is:inline>
            // Con View Transitions le pagine cambiano senza ricaricare: si conta ogni pagina vista.
            document.addEventListener('astro:page-load', function () {
              var send = function () { window.goatcounter && window.goatcounter.count && window.goatcounter.count({ path: location.pathname }); };
              if (window.goatcounter && window.goatcounter.count) send(); else setTimeout(send, 1500);
            });
          </script>
        </>
      )
    }
  </head>
  <body class="noise min-h-dvh">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[100] btn btn-primary"
      >{d.meta.skip}</a
    >
    <div class="spotlight" aria-hidden="true"></div>
    <div
      data-progress
      class="fixed top-0 left-0 right-0 h-[2px] z-[70] origin-left scale-x-0"
      style="background: linear-gradient(90deg, var(--color-volt), var(--color-flutter), var(--color-web))"
      aria-hidden="true"
      transition:persist
    >
    </div>
    <Nav lang={lang} alternate={alternate ?? url(lang === 'it' ? '/en/' : '/')} />
    <main id="main" class="relative z-10">
      <slot />
    </main>
    <Footer lang={lang} />
    <script>
      import '../scripts/interactions.ts';
      import '../scripts/view.ts';
      import '../scripts/cursor.ts';
    </script>
  </body>
</html>
